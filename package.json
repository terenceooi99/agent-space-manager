{
  "name": "agent-space-manager",
  "version": "1.0.3",
  "description": "Universal Agent Space Manager & Dynamic Intent-Based MCP Tool Gateway for Magpie",
  "type": "module",
  "main": "./index.mjs",
  "files": [
    "index.mjs",
    "manager.mjs",
    "adapters.mjs",
    "agents.mjs",
    "server.mjs",
    "smart-tools.middleware.js",
    "page/index.html",
    "page/app.js",
    "page/style.css",
    "page/icon.svg",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test --test-reporter=spec tests/*.test.mjs",
    "test:relevant": "node --test --test-reporter=spec",
    "test:report": "node --test --test-reporter=junit --test-reporter-destination=tests/report.xml tests/*.test.mjs",
    "test:universal": "node --test --test-reporter=spec tests/any-condition-usability.test.mjs"
  },
  "keywords": [
    "magpie",
    "magpie-plugin",
    "middleware",
    "gateway",
    "tools",
    "mcp",
    "agent-space",
    "skills-manager"
  ],
  "author": "Terence Ooi",
  "license": "MIT",
  "funding": "https://wise.com/pay/me/terenceooit",
  "engines": {
    "node": ">=18.0.0"
  },
  "magpie": {
    "title": "Agent Space Manager",
    "name": "Agent Space Manager",
    "icon": "page/icon.svg",
    "page": {
      "title": "Agent Space Manager",
      "file": "page/index.html",
      "icon": "page/icon.svg"
    },
    "hooks": "./smart-tools.middleware.js",
    "options": {
      "smartMiddlewareEnabled": true,
      "maxTools": 96,
      "autoFilter": true,
      "logFailures": true,
      "toolsRoot": "",
      "hubConfig": null,
      "omnirouteRequest": null,
      "connectRequest": null
    },
    "optionsExample": {
      "smartMiddlewareEnabled": true,
      "maxTools": 96,
      "autoFilter": true,
      "logFailures": true,
      "toolsRoot": ""
    }
  }
}
